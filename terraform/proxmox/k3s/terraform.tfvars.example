# For a direct Terraform run, copy to terraform.tfvars (gitignored) and fill in; build-project.yaml reads these from terraform_k3s in the inventory instead
gateway       = "192.0.2.1"
storage_pool  = "local-zfs"
template_name = "debian-cloud-template"
ci_user       = "ansible"

nodes = [
  { name = "k3s-node-1", vm_id = 1060, target_node = "pve-a", address = "192.0.2.60" },
  { name = "k3s-node-2", vm_id = 1061, target_node = "pve-b", address = "192.0.2.61" },
  { name = "k3s-node-3", vm_id = 1062, target_node = "pve-c", address = "192.0.2.62" },
]
