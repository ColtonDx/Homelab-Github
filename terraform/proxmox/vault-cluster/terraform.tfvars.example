# For a direct Terraform run, copy to terraform.tfvars (gitignored) and fill in; build-project.yaml builds these from the vault_cluster inventory group instead
# Proxmox credentials come from TF_VAR_* environment variables instead
storage_pool  = "local-zfs"
gateway       = "192.0.2.1"
template_name = "debian-cloud-template"

nodes = [
  { name = "vault-1", vm_id = 401, target_node = "pve-node-1", address = "192.0.2.41" },
  { name = "vault-2", vm_id = 402, target_node = "pve-node-2", address = "192.0.2.42" },
  # A host with no copy of the template: build on a host that has one, on storage with the same name on both
  # hosts, then change target_node and apply again; the provider migrates the VM with its local disks
  { name = "vault-3", vm_id = 403, target_node = "pve-node-1", address = "192.0.2.43", storage_pool = "local" },
]
