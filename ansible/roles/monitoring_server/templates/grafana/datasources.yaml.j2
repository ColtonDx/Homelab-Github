# {{ ansible_managed }}
# The stack's own Prometheus and Loki, with fixed UIDs so dashboards and alert rules can refer to them
apiVersion: 1

datasources:
  - name: Prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: true
    editable: false

  - name: Loki
    uid: loki
    type: loki
    access: proxy
    url: http://loki:3100
    editable: false
