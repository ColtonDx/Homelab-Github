# {{ ansible_managed }}
# Read-only OPNsense API user for the exporter
OPNSENSE_EXPORTER_OPS_PROTOCOL=https
OPNSENSE_EXPORTER_OPS_API={{ monitoring_server_opnsense_address }}
OPNSENSE_EXPORTER_OPS_API_KEY={{ monitoring_server_opnsense_api_key }}
OPNSENSE_EXPORTER_OPS_API_SECRET={{ monitoring_server_opnsense_api_secret }}
OPNSENSE_EXPORTER_OPS_INSECURE={{ (not monitoring_server_opnsense_verify_ssl | bool) | lower }}
OPNSENSE_EXPORTER_INSTANCE_LABEL=opnsense
