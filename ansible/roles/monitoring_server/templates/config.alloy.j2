// {{ ansible_managed }}
// Receives syslog from devices that can't run an agent and sends it to Loki, labelled by the sending host

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Turns syslog header fields into labels for searching in Grafana
loki.relabel "syslog" {
  forward_to = []

  rule {
    source_labels = ["__syslog_message_hostname"]
    target_label  = "host"
  }

  rule {
    source_labels = ["__syslog_message_severity"]
    target_label  = "level"
  }

  rule {
    source_labels = ["__syslog_message_app_name"]
    target_label  = "app"
  }
}

loki.source.syslog "devices" {
{% for listener in monitoring_server_syslog_listeners %}
  listener {
    address       = "0.0.0.0:{{ listener.port }}"
    protocol      = "{{ listener.protocol }}"
    syslog_format = "{{ listener.format }}"
    labels        = { job = "syslog" }
  }

{% endfor %}
  relabel_rules = loki.relabel.syslog.rules
  forward_to    = [loki.process.syslog.receiver]
}

// OPNsense firewall log lines (filterlog, comma-separated) get action, direction and interface labels; every other line passes through untouched
loki.process "syslog" {
  forward_to = [loki.write.local.receiver]

  stage.match {
    selector = "{app=\"filterlog\"}"

    // Field order: rule, sub-rule, anchor, tracker, interface, reason, action, direction, IP version, then version-specific fields up to the destination
    stage.regex {
      expression = `^[^,]*,[^,]*,[^,]*,[^,]*,(?P<fl_interface>[^,]*),[^,]*,(?P<fl_action>[^,]*),(?P<fl_direction>[^,]*),4,(?:[^,]*,){10}(?P<fl_dst>[^,]*)`
    }

    stage.regex {
      expression = `^[^,]*,[^,]*,[^,]*,[^,]*,(?P<fl_interface>[^,]*),[^,]*,(?P<fl_action>[^,]*),(?P<fl_direction>[^,]*),6,(?:[^,]*,){7}(?P<fl_dst>[^,]*)`
    }

    stage.labels {
      values = { action = "fl_action", direction = "fl_direction", interface = "fl_interface" }
    }
{% if monitoring_server_geoip | bool %}

    // Outbound WAN traffic gets the destination's country; private, loopback, link-local and multicast destinations are skipped
    stage.match {
      selector = "{direction=\"out\", interface=~\"{{ monitoring_server_filterlog_wan_interfaces | join('|') }}\"}"

      stage.template {
        source   = "fl_dst_scope"
        template = `{% raw %}{{ if regexMatch "^(10[.]|127[.]|0[.]|169[.]254[.]|192[.]168[.]|172[.](1[6-9]|2[0-9]|3[01])[.]|100[.](6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])[.]|2(2[4-9]|[3-5][0-9])[.]|f[cd]|fe[89ab]|ff|::)" .fl_dst }}private{{ else }}public{{ end }}{% endraw %}`
      }

      stage.labels {
        values = { dst_scope = "fl_dst_scope" }
      }

      stage.match {
        selector = "{dst_scope=\"public\"}"

        // The database is read when Alloy starts; the weekly refresh restarts Alloy after a new download
        stage.geoip {
          db      = "/etc/alloy/geoip/GeoLite2-City.mmdb"
          db_type = "city"
          source  = "fl_dst"
        }

        stage.labels {
          values = { geoip_country_code = "" }
        }
      }

      stage.label_drop {
        values = ["dst_scope"]
      }
    }
{% endif %}
  }
}
