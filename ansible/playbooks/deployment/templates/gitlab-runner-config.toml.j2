# Managed by app-gitlab-runner.yaml; local changes are overwritten on the next run
concurrent = {{ gitlab_runner_concurrent }}
check_interval = 0
{% if gitlab_runner_metrics_address | length > 0 %}
# Prometheus metrics, also polled by Uptime Kuma as the runner's health check
listen_address = "{{ gitlab_runner_metrics_address }}"
{% endif %}

[[runners]]
  name = "{{ gitlab_runner_name }}"
  url = "{{ gitlab_runner_url }}"
  # Runner authentication token from Vault; tags and untagged-job settings live in GitLab with this token
  token = "{{ gitlab_runner_token }}"
{% if gitlab_runner_tls_ca_file | length > 0 %}
  tls-ca-file = "{{ gitlab_runner_tls_ca_file }}"
{% endif %}
  executor = "docker"
  [runners.docker]
    image = "{{ gitlab_runner_default_image }}"
    privileged = {{ gitlab_runner_privileged | bool | lower }}
    volumes = {{ gitlab_runner_volumes | to_json }}
    shm_size = 0
