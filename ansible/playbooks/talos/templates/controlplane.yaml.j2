# Rendered by ansible/playbooks/talos/init-cluster.yaml and applied to controlplane nodes only
---
machine:
  # Certificates must cover the VIP and every controlplane address, or connections through them are rejected
  certSANs:
    - {{ talos_cluster.vip }}
{% for n in talos_controlplane_nodes %}
    - {{ n.address }}
{% endfor %}
cluster:
  allowSchedulingOnControlPlanes: {{ talos_cluster.allow_scheduling_on_control_planes | default(true) | bool | lower }}
  apiServer:
    certSANs:
      - {{ talos_cluster.vip }}
{% for n in talos_controlplane_nodes %}
      - {{ n.address }}
{% endfor %}
  etcd:
    # Pin etcd peering to the node network so it cannot pick a CNI address
    advertisedSubnets:
      - {{ talos_cluster.node_cidr }}
