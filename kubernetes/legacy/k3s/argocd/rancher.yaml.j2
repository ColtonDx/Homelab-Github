---
# Rendered and applied by ansible/playbooks/k3s/service-argo-bootstrap.yaml; the repo and site values come from its vars and the inventory
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: rancher
  namespace: argocd
spec:
  project: default
  sources:
    - repoURL: https://releases.rancher.com/server-charts/latest
      chart: rancher
      targetRevision: 2.15.0
      helm:
        releaseName: rancher
        valueFiles:
          - $values/kubernetes/legacy/k3s/values/rancher.yaml
        # Wins over the values file, so the host never has to be in Git
        valuesObject:
          hostname: rancher.{{ traefik_domain }}
    - repoURL: {{ argocd_repo }}
      targetRevision: {{ argocd_ref }}
      ref: values
  destination:
    server: https://kubernetes.default.svc
    namespace: cattle-system
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - ServerSideApply=true
